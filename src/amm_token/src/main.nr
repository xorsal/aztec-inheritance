// AmmToken - PoC: single contract that IS both an AMM pool AND a full AIP-20 token.
//
// SC-3 (PRD): add_liquidity drives token state via self.internal._mint_to_private
//             using the SAME internal path as the canonical Token contract.
//
// SC-2 (PRD): The full AIP-20 external surface is generated by generic template composition --
//             the developer writes ONLY the lines below (AMM-specific logic).
//             No token function is written or copied here.
//
// Storage note (L-4): #[storage] does not yet support nested structs. Token fields
// are inlined alongside pool fields until that limitation is lifted.

pub mod test;

use aztec::macros::{AztecConfig, aztec};

#[aztec(AztecConfig::new().compose("aip20_token"))]
pub contract Amm {
    use aztec::{
        macros::{
            events::event,
            functions::{external, initializer, internal, only_self, view},
            storage::storage,
        },
        protocol::address::AztecAddress,
        state_vars::{Map, Owned, PublicImmutable, PublicMutable, StateVariable},
    };
    use compressed_string::FieldCompressedString;
    use balance_set::BalanceSet;
    use aztec_token_mixin::TokenInitParams;
    // FromField is required by the token functions injected via template composition.
    // It appears unused to the compiler (Amm's own code does not reference it directly)
    // but is needed to bring the from_field trait method into scope for generated bodies.
    use aztec::protocol::traits::FromField;

    // The Transfer event is required by the composed token functions.
    // It must match the token template's Transfer event signature exactly.
    #[event]
    struct Transfer {
        from: AztecAddress,
        to: AztecAddress,
        amount: u128,
    }

    #[storage]
    struct Storage<Context> {
        // Token fields (name/symbol/decimals/private_balances/total_supply/public_balances/minter)
        // are contributed by the composed aip20_token template; no need to inline.
        reserve_a: PublicMutable<u128, Context>,
        reserve_b: PublicMutable<u128, Context>,
        token_a: PublicImmutable<AztecAddress, Context>,
        token_b: PublicImmutable<AztecAddress, Context>,
        total_shares: PublicMutable<u128, Context>,
    }

    // AMM constructor: initializes pool fields and delegates token field init to
    // the composed _initialize_token internal. minter = this address enables SC-3.
    #[initializer]
    #[external("public")]
    fn constructor(
        token_a: AztecAddress,
        token_b: AztecAddress,
        name: str<31>,
        symbol: str<31>,
        decimals: u8,
    ) {
        self.internal._initialize_token(TokenInitParams {
            name,
            symbol,
            decimals,
            minter: self.context.this_address(),
        });
        self.storage.token_a.initialize(token_a);
        self.storage.token_b.initialize(token_b);
    }

    // AMM-specific: provider deposits token_a + token_b, receives LP shares.
    // SC-3: pool function drives token state via self.internal._mint_to_private.
    // Token internals (_mint_to_private, etc.) are provided by the composed template.
    #[external("private")]
    fn add_liquidity(provider: AztecAddress, amount_a: u128, amount_b: u128) {
        let shares = amount_a; // simplified: 1:1 for PoC initial deposit
        // SC-3 demonstrated: pool entrypoint mints LP tokens through token internals
        self.internal._mint_to_private(provider, shares);
        self.enqueue_self.update_reserves_internal(amount_a, amount_b);
    }

    // AMM-specific: update on-chain reserves after a deposit (enqueued from private).
    // Must be #[external("public")] #[only_self] so it can be enqueued from add_liquidity.
    #[external("public")]
    #[only_self]
    fn update_reserves_internal(amount_a: u128, amount_b: u128) {
        let new_a = self.storage.reserve_a.read() + amount_a;
        let new_b = self.storage.reserve_b.read() + amount_b;
        self.storage.reserve_a.write(new_a);
        self.storage.reserve_b.write(new_b);
    }

    // AMM-specific view: read current pool reserves.
    #[view]
    #[external("public")]
    fn get_reserves() -> (u128, u128) {
        (self.storage.reserve_a.read(), self.storage.reserve_b.read())
    }

    // =========================================================================
    // ALL AIP-20 token external functions are generated by the composed template:
    //   transfer_private_to_private, transfer_private_to_public,
    //   transfer_public_to_public, transfer_public_to_private,
    //   transfer_private_to_commitment, transfer_public_to_commitment,
    //   initialize_transfer_commitment, recurse_subtract_balance_internal,
    //   mint_to_private, mint_to_public, mint_to_commitment,
    //   burn_private, burn_public,
    //   increase_public_balance_internal, decrease_public_balance_internal,
    //   increase_total_supply_internal, decrease_total_supply_internal,
    //   balance_of_public, total_supply, name, symbol, decimals (view),
    //   balance_of_private (utility)
    //
    // ALL token internal functions are generated by the composed template:
    //   _initialize_token (public - call from constructor with TokenInitParams),
    //   _mint_to_private, _burn_private, _increase_private_balance,
    //   _decrease_private_balance, _subtract_balance,
    //   _initialize_transfer_commitment, _mint_to_public, _burn_public,
    //   _increase_public_balance, _decrease_public_balance,
    //   _increase_commitment_balance, _increase_total_supply, _decrease_total_supply
    // =========================================================================
}
